            <div class="mt-6 flex justify-end">
              <button
                type="button"
                (click)="cerrarModal()"
                class="rounded-2xl bg-slate-950 px-5 py-3 text-sm font-black text-white hover:bg-slate-800"
              >
                Cerrar
              </button>
            </div>
          </div>
        }
      }
    </div>
  </div>
}
